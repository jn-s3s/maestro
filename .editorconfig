# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Python specific overrides (PEP 8 standards)
[*.py]
max_line_length = 79

# Markdown overrides (preserve trailing spaces for line breaks)
[*.md]
trim_trailing_whitespace = false

# Web/Frontend overrides (Vue, JavaScript, HTML, CSS, JSON)
[*.{js,jsx,ts,tsx,vue,html,css,json}]
indent_size = 4
insert_final_newline = true
