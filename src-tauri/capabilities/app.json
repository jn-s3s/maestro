{
    "identifier": "app",
    "description": "The local Maestro window may read, edit, snapshot and browse only registered configuration files.",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "allow-list-tools",
        "allow-read-file",
        "allow-write-file",
        "allow-file-stat",
        "allow-reveal-path",
        "allow-open-file",
        "allow-open-external",
        "allow-get-settings",
        "allow-set-hidden",
        "allow-set-theme",
        "allow-set-close-to-tray",
        "allow-set-soft-wrap",
        "allow-add-custom",
        "allow-remove-custom",
        "allow-push-recent",
        "allow-list-backups",
        "allow-read-backup",
        "allow-delete-backup",
        "allow-clear-backups",
        "allow-watch-file",
        "allow-watch-folder",
        "allow-list-folder",
        "allow-create-file-in",
        "allow-create-folder-in",
        "allow-rename-file",
        "allow-rename-folder",
        "allow-delete-file",
        "allow-delete-folder"
    ]
}
