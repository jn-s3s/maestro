{
    "name": "maestro",
    "version": "1.1.0",
    "private": true,
    "description": "Maestro - conduct all your AI coding agent configurations from one podium",
    "main": "./out/main/index.js",
    "author": "jn-s3s",
    "license": "MIT",
    "packageManager": "pnpm@10.33.2",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "icon": "node scripts/generate-icons.mjs",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "lint": "oxlint --deny=correctness --deny=suspicious --deny=perf -D eslint . && eslint .",
        "lint:fix": "oxlint --fix . && eslint --fix .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "dist": "pnpm icon && electron-vite build && electron-builder",
        "logs": "node scripts/dump-logs.mjs",
        "clear": "node scripts/clear-data.mjs",
        "postinstall": "node node_modules/electron/install.js"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "electron",
            "esbuild",
            "@tailwindcss/oxide",
            "sharp"
        ]
    },
    "dependencies": {
        "@codemirror/commands": "^6.11.0",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/language": "^6.12.4",
        "@codemirror/state": "^6.7.2",
        "@codemirror/view": "^6.43.10",
        "@fontsource-variable/inter": "^5.3.0",
        "@iarna/toml": "^2.2.5",
        "@lezer/highlight": "^1.2.3",
        "@shopify/lang-jsonc": "^1.0.1",
        "codemirror": "^6.0.2",
        "diff": "^9.0.0",
        "lucide-react": "^1.43.0",
        "prettier": "^3.9.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.4.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^5.2.0",
        "electron": "^44.1.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-oxlint": "^1.84.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.5",
        "globals": "^17.11.0",
        "oxlint": "^1.85.0",
        "sharp": "^0.35.4",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^7.3.6"
    }
}
